FROM nvidia/cuda:13.2.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    P3S_BENCH_CUDA=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-dev python3-venv \
        build-essential cmake ninja-build \
        libsuitesparse-dev \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# libcuda.so exists only as a stub until the driver is injected at runtime,
# so point the linker at the stubs directory for this build step only.
RUN LIBRARY_PATH=/usr/local/cuda/lib64/stubs:$LIBRARY_PATH \
    pip install --no-cache-dir numpy pycuda

RUN python3 -m pip install --no-cache-dir nvidia-cudss-cu13 \
    && find "$VIRTUAL_ENV/lib" -type d -path '*/site-packages/nvidia/*/lib' -print \
        > /etc/ld.so.conf.d/nvidia-python-libs.conf \
    && test -s /etc/ld.so.conf.d/nvidia-python-libs.conf \
    && ldconfig

WORKDIR /opt/p3s
COPY . /opt/p3s

RUN pip install --no-cache-dir ./p3s/cpp
RUN pip install --no-cache-dir .

RUN pip install pytest

ENTRYPOINT ["python3", "-m", "pytest", "tests"]
